# Copy to .env and fill in, or run `npm run setup`.

# Destination for the daily digest
DIGEST_TO=you@example.com
MAIL_FROM=Scholarship Watcher <you@example.com>

# SMTP (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Or use Resend instead of SMTP
# RESEND_API_KEY=re_xxxxxxxxx

# Daily schedule time used by `npm run schedule`
SCHEDULE_TIME=08:00

# Watcher behaviour
SEND_EMPTY=true
MAX_AGE_DAYS=60
ENRICH_LIMIT=30
# Keep this false until email works: local runs will not consume the backlog.
SAVE_WITHOUT_EMAIL=false

# Optional AI verification through the local opencode CLI
USE_LLM=false
OPENCODE_MODEL=
OPENCODE_BIN=opencode
LLM_LIMIT=24
LLM_TIMEOUT_MS=240000

# Set to 1 to watch the headless Instagram browser during a run (debug)
# IG_HEADED=1

# Hosted watchlist (Cloudflare Pages)
CLOUD_URL=https://scholarship-by0.pages.dev
CLOUD_ADMIN_SECRET=
PUBLISH_CLOUD=true
